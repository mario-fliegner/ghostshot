    <string name="guide_detail_getting_started_step2_title">Line up the photo</string>
    <string name="guide_detail_getting_started_step2_body">Return to the same spot and align the reference photo with the live camera view.</string>
    <string name="guide_detail_getting_started_step3_title">Take the shot</string>
    <string name="guide_detail_getting_started_step3_body">Capture the new photo when the scene matches the reference.</string>
    <string name="guide_detail_getting_started_step4_title">See what changed</string>
    <string name="guide_detail_getting_started_step4_body">Compare the reference photo with your new shot.</string>
    <string name="guide_detail_getting_started_completion_title">Ready to get started?</string>
    <string name="guide_detail_getting_started_completion_body">Choose a reference photo and recreate it with SameView.</string>
    <string name="guide_detail_reference_photos_intro">Use a reference photo to recreate the original shot.</string>
    <string name="guide_detail_reference_photos_step1_title">Pick a reference photo</string>
    <string name="guide_detail_reference_photos_body_1">Pick a photo you want to recreate.</string>
    <string name="guide_detail_reference_photos_step2_title">Line up the photo</string>
    <string name="guide_detail_reference_photos_body_2">Move, resize and fade the reference photo until it matches the live view.</string>
    <string name="guide_detail_reference_photos_step3_title">Use reference markers</string>
    <string name="guide_detail_markers_body_1">Place markers on details that stay visible even when the reference photo is faded out.</string>
    <string name="guide_detail_reference_photos_completion_title">You\'re ready to capture</string>
    <string name="guide_detail_reference_photos_completion_body">Once the reference photo is aligned and marked, capture the new photo for comparison.</string>
    <string name="guide_detail_gps_intro">GPS guidance helps you get back to where the reference photo was taken.</string>
    <string name="guide_detail_gps_enable_heading">Enable GPS guidance</string>
    <string name="guide_detail_gps_enable_body">GPS guidance is disabled by default and only works when the reference photo contains location data.&lt;br/&gt;&lt;br/&gt;Open &lt;b&gt;Settings → Location guidance&lt;/b&gt; and enable &lt;b&gt;Show reference location&lt;/b&gt; to use location information from reference photos. You can also enable &lt;b&gt;Live direction arrow&lt;/b&gt; for on-screen direction cues.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Use the camera view&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;GPS guidance helps you return near the original location. Use the live camera view to match the final composition.</string>
    <string name="guide_detail_export_intro">Export lets you create images, videos, and backups from saved sessions.</string>
    <string name="guide_detail_export_step1_title">Share image</string>
    <string name="guide_detail_share_body_1">Create a shareable image from a saved session.&lt;br/&gt;&lt;br/&gt;Choose a layout and select the information you want to include.</string>
    <string name="guide_detail_export_step2_title">Create video</string>
    <string name="guide_detail_video_body_1">Turn a comparison into a video.&lt;br/&gt;&lt;br/&gt;Choose a style, duration, format, and quality before rendering.</string>
    <string name="guide_detail_export_step3_title">Back up sessions</string>
    <string name="guide_detail_backups_body_1">Create a backup to keep your sessions safe.&lt;br/&gt;&lt;br/&gt;Back up a single session or multiple sessions from the library.</string>

